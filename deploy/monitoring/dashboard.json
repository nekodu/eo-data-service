{
  "title": "EO data service",
  "uid": "eods",
  "schemaVersion": 39,
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries", "title": "Requests per second by route and status",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (route, status) (rate(eods_http_requests_total{route!~\"/metrics|/healthz|/readyz\"}[1m]))", "legendFormat": "{{route}} {{status}}"}]
    },
    {
      "type": "timeseries", "title": "p95 latency (s)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(eods_http_request_duration_seconds_bucket{route!~\"/metrics|/healthz|/readyz\"}[5m])))", "legendFormat": "{{route}}"}]
    },
    {
      "type": "timeseries", "title": "Rejected tokens by reason",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (reason) (rate(eods_auth_failures_total[5m]))", "legendFormat": "{{reason}}"}]
    },
    {
      "type": "stat", "title": "Cube age (minutes)",
      "gridPos": {"x": 12, "y": 8, "w": 6, "h": 8},
      "targets": [{"expr": "(time() - max(eods_cube_latest_timestamp_seconds)) / 60"}]
    },
    {
      "type": "stat", "title": "Time steps in cube",
      "gridPos": {"x": 18, "y": 8, "w": 6, "h": 8},
      "targets": [{"expr": "max(eods_cube_time_steps)"}]
    }
  ]
}
